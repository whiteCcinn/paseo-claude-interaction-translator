{
  "name": "paseo-claude-interaction-translator",
  "version": "0.1.0",
  "private": true,
  "description": "Translate Paseo drafts explicitly and final assistant replies automatically",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/whiteCcinn/paseo-claude-interaction-translator.git"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:coverage": "c8 --include='server/**/*.ts' --include='shared/**/*.ts' --include='client/draft.ts' npm test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@getpaseo/client": "0.15.4",
    "@getpaseo/plugin": "0.15.4",
    "@getpaseo/protocol": "0.15.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.0",
    "c8": "^10.1.3",
    "esbuild": "^0.25.12",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
